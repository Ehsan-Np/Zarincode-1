parameters:
    level: 10
    tmpDir: .phpstan-cache
    parallel:
        maximumNumberOfProcesses: 1
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - constants.php
        - woocommerce-api.php
        - elementor-api.php
    paths:
        - ../../zarincode-core/includes/Support/Settings_Schema.php
        - ../../zarincode-core/includes/Content
        - ../../zarincode-core/includes/Admin
        - ../../zarincode-core/includes/Features
        - ../../zarincode/inc/Elementor/Kit_Defaults.php
