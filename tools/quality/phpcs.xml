<?xml version="1.0"?>
<ruleset name="ZarinCode critical service checks">
  <description>WPCS on the critical services currently being hardened. PSR-4 filenames follow the project's required autoloader, not WordPress class-file naming.</description>
  <rule ref="WordPress"><exclude name="WordPress.Files.FileName"/></rule>
  <file>../../zarincode-core/includes/Support/Settings_Schema.php</file>
  <file>../../zarincode-core/includes/Content</file>
  <file>../../zarincode-core/includes/Admin</file>
  <file>../../zarincode-core/includes/Features</file>
  <rule ref="WordPress.WP.Capabilities"><properties><property name="custom_capabilities" type="array"><element value="manage_woocommerce"/></property></properties></rule>
  <!-- PHP DOM extension property identifiers, not project naming exceptions. -->
  <rule ref="WordPress.NamingConventions.ValidVariableName"><properties><property name="allowed_custom_properties" type="array"><element value="documentElement"/><element value="localName"/><element value="childNodes"/></property></properties></rule>
</ruleset>
